# Copy this file to .env and fill in your real values.
# Example (Windows PowerShell):
#   copy .env.example .env

# SQLite file database (default — no PostgreSQL needed)
# The file food_recommendation.db is created in the backend folder.
DATABASE_URL=sqlite:///./food_recommendation.db

# Optional later: PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/food_recommendation

# Gemini (Google AI Studio) — used by AutoGen agents
# Create a key at: https://aistudio.google.com/apikey
# Never commit your real key.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Other useful models (change GEMINI_MODEL if you want):
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL=gemini-2.5-flash
